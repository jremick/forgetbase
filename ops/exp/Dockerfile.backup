# A plain base avoids inheriting the server image's anonymous PGDATA volume.
FROM alpine:3.24@sha256:294b683cb724975bec92580e1e685676bd4b50bda910ddb8c51d4cabeaec77e6
RUN apk add --no-cache postgresql17-client age bash rclone tar curl ca-certificates \
    && addgroup -g 999 expbackup \
    && adduser -D -H -u 999 -G expbackup expbackup
ARG FORGETBASE_SOURCE_REVISION
LABEL org.opencontainers.image.source="https://github.com/jremick/forgetbase" \
      org.opencontainers.image.revision=$FORGETBASE_SOURCE_REVISION
USER 999:999
ENTRYPOINT []
# Installed by the operator as a read-only bind mount.
CMD ["bash", "/opt/exp/backup.sh"]
