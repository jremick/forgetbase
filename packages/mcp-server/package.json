{
  "name": "@forgetbase/mcp-server",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/server.ts",
      "import": "./dist/server.js"
    },
    "./local": {
      "types": "./src/local-server.ts",
      "import": "./dist/local-server.js"
    }
