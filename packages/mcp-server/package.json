  },
  "dependencies": {
    "@forgetbase/local-runtime": "workspace:*",
    "@forgetbase/schema": "workspace:*",
    "@forgetbase/sdk": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
